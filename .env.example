# TeachCoachConnect client environment variables
# Copy this file to .env and replace placeholder values.
# Only include browser-safe variables prefixed with VITE_.

# Supabase project URL (example: https://your-project-id.supabase.co)
VITE_SUPABASE_URL="<your-supabase-url>"

# Supabase browser publishable (anon) key
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-publishable-key>"

# Optional: Supabase project ID used by local tooling/docs
VITE_SUPABASE_PROJECT_ID="<your-supabase-project-id>"
